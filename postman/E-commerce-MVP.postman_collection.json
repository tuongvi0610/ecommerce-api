{
  "info": {
    "name": "E-commerce MVP rubric demo",
    "description": "Chạy Register → Login → Products → Order không token (401) → Order có token → xem Order → xem Shipment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001" },
    { "key": "username", "value": "student01" },
    { "key": "token", "value": "" },
    { "key": "productXId", "value": "1" },
    { "key": "productYId", "value": "2" },
    { "key": "orderId", "value": "" },
    { "key": "shipmentId", "value": "" }
  ],
  "item": [
    {
      "name": "1 Register normal member",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{username}}\",\n  \"fullname\": \"Student One\",\n  \"password\": \"password123\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/auth/register" },
      "event": [{ "listen": "prerequest", "script": { "type": "text/javascript", "exec": ["pm.collectionVariables.set('username', 'student' + Date.now());"] } },
      { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Created with normal role and score 10', () => {", "  pm.response.to.have.status(201);", "  const body = pm.response.json();", "  pm.expect(body.role.rolename).to.eql('normal');", "  pm.expect(body.membership.score).to.eql(10);", "  pm.expect(body).not.to.have.property('password');", "});"] } }]
    },
    {
      "name": "2 Login and save token",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"password123\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/auth/login" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Login returns JWT', () => {", "  pm.response.to.have.status(200);", "  const body = pm.response.json();", "  pm.expect(body.tokenType).to.eql('Bearer');", "  pm.collectionVariables.set('token', body.token);", "});"] } }]
    },
    {
      "name": "3 List products (capture X and Y IDs)",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/products" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Product X and Y are seeded', () => {", "  pm.response.to.have.status(200);", "  const products = pm.response.json();", "  const x = products.find(p => p.pname === 'Product X');", "  const y = products.find(p => p.pname === 'Product Y');", "  pm.expect(x).to.exist; pm.expect(y).to.exist;", "  pm.collectionVariables.set('productXId', x.pid);", "  pm.collectionVariables.set('productYId', y.pid);", "});"] } }]
    },
    {
      "name": "4 Order without token (expect 401)",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"items\": [\n    { \"pid\": {{productXId}}, \"qty\": 2 },\n    { \"pid\": {{productYId}}, \"qty\": 5 }\n  ]\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/orders" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Unauthenticated order is rejected', () => pm.response.to.have.status(401));"] } }]
    },
    {
      "name": "5 Create order X2 Y5 (JWT required)",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "body": { "mode": "raw", "raw": "{\n  \"items\": [\n    { \"pid\": {{productXId}}, \"qty\": 2 },\n    { \"pid\": {{productYId}}, \"qty\": 5 }\n  ]\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/orders" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Order and shipment created', () => {", "  pm.response.to.have.status(201);", "  const body = pm.response.json();", "  pm.collectionVariables.set('orderId', body.oid);", "  pm.collectionVariables.set('shipmentId', body.shipments[0].shipid);", "  pm.expect(body.details).to.have.length(2);", "  pm.expect(body.shipments[0].status).to.eql('PENDING');", "});"] } }]
    },
    {
      "name": "6 Get my order and details",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/orders/{{orderId}}" }
    },
    {
      "name": "7 Get shipment",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/shipments/{{shipmentId}}" }
    }
  ]
}
